APP_ORIGIN=https://mediqueue-krishnashaw42011-7915.vercel.app
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: RAZORPAY_WEBHOOK_SECRET=
# Vercel's Supabase integration provides POSTGRES_URL automatically.
# DATABASE_URL may be used instead when deploying without that integration.
POSTGRES_URL=postgresql://USERNAME:PASSWORD@POOLER-HOST:6543/postgres
PAYMENT_ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
# Supabase session proxy (public values; never add a service-role key to NEXT_PUBLIC_):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# DATABASE_CA_CERT=
# Optional real SMS provider configuration:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
